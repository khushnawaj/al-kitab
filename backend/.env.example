# Al-Kitab Backend Environment Configuration
# Copy this file to .env and provide your actual secrets

# Port to run the server on
PORT=5000

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/al_kitab

# JWT Secret keys (Use at least 32-64 random characters in production)
ACCESS_TOKEN_SECRET=replace_with_a_secure_random_access_secret_key_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_refresh_secret_key_at_least_32_chars

# Frontend client URL for CORS and cookie origin
CLIENT_URL=http://localhost:5173
